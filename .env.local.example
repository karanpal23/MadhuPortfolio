# Copy this file to .env.local and fill in real values.
# .env.local is git-ignored so secrets stay on your machine.

# Where contact-form messages get delivered.
CONTACT_TO_EMAIL=madhusalaria1996@gmail.com

# The verified sender address in your Resend account.
# Format: "Name <address@yourdomain.com>". Must be on a verified domain.
CONTACT_FROM_EMAIL=CodesFoundry <no-reply@codesfoundry.com>

# Resend API key — https://resend.com/api-keys
RESEND_API_KEY=

# Public site URL used by sitemap.ts and robots.ts.
# On Vercel this is set automatically; fill in for local builds.
NEXT_PUBLIC_SITE_URL=https://codesfoundry.com
